# Public URL of the deployed site. It is shown (and encoded as a QR code) in the hero so a projected page can be
# opened from a phone. Copy this file to `.env` to override the default defined in src/config/site.js.
# Only variables prefixed with VITE_ are exposed to the browser: never put secrets here.
VITE_SITE_URL=https://fisica.5touni.workers.dev
